NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your-password-here
NEO4J_DATABASE=neo4j

# MCP server (mcp_server/server.py): two different random tokens.
# PUBLIC sees public pages only; STAFF also sees internal pages.
MCP_AUTH_TOKEN_PUBLIC=
MCP_AUTH_TOKEN_STAFF=

# Telegram bot (bot/egd_telegram_bot.py)
TELEGRAM_BOT_TOKEN=
GEMINI_API_KEY=
# Optional: comma-separated numeric Telegram user IDs that get staff (internal) answers
EGD_STAFF_TELEGRAM_IDS=
# Optional overrides
# MCP_URL=https://rinabuoy13--egd-wiki-mcp-web.us-east.modal.run/mcp
# GEMINI_MODEL=gemini-flash-lite-latest
